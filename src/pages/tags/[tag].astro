---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

/**
 * /tags/<tag> — every published article carrying that tag.
 * Generated statically so each tag URL is its own indexable
 * landing page (good for the long-tail SEO this site is built
 * around).
 */
export async function getStaticPaths() {
  const all = (await getCollection('articles')).filter(
    (e) => !e.data.draft,
  );
  const tagSet = new Set<string>();
  for (const entry of all) {
    for (const tag of entry.data.tags) tagSet.add(tag);
  }
  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: {
      tag,
      entries: all
        .filter((e) => e.data.tags.includes(tag))
        .sort(
          (a, b) =>
            b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
        ),
    },
  }));
}

const { tag, entries } = Astro.props;
---
<BaseLayout
  title={`#${tag} — Fola Articles`}
  description={`Articles tagged #${tag} — every USCIS / DOS / DHS announcement on this topic, plain-English.`}
  canonical={`https://articles.folaform.com/tags/${tag}`}
>
  <section class="hero shell">
    <span class="pill">#{tag}</span>
    <h1>Tagged #{tag}</h1>
    <p class="hero__lede">
      Every article we've published on this topic, sorted by the
      agency's own announcement date.
    </p>
  </section>

  <section class="list shell">
    <div class="grid">
      {entries.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 48px 0 24px;
  }
  .hero h1 {
    margin: 12px 0 14px;
    font-size: 2rem;
  }
  .hero__lede {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 64ch;
  }
  .list {
    padding-bottom: 36px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 18px;
  }
</style>
