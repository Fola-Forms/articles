---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

/**
 * /authority/<USCIS|DOS|DHS|…> — every published article tagged
 * with the matching authority. Static-built so each authority
 * page has its own canonical URL Google can index.
 */
export async function getStaticPaths() {
  const all = (await getCollection('articles')).filter(
    (e) => !e.data.draft,
  );
  const authorities = Array.from(
    new Set(all.map((e) => e.data.authority)),
  );
  return authorities.map((authority) => ({
    params: { authority },
    props: {
      authority,
      entries: all
        .filter((e) => e.data.authority === authority)
        .sort(
          (a, b) =>
            b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
        ),
    },
  }));
}

const { authority, entries } = Astro.props;
const titleByAuthority: Record<string, string> = {
  USCIS: 'U.S. Citizenship and Immigration Services',
  DOS: 'U.S. Department of State',
  DHS: 'U.S. Department of Homeland Security',
  'DOJ-EOIR': 'Executive Office for Immigration Review',
  DOL: 'U.S. Department of Labor',
  OTHER: 'Other authorities',
};
const long = titleByAuthority[authority] ?? authority;
---
<BaseLayout
  title={`${authority} — ${long} | Fola Articles`}
  description={`Every ${long} memo, rule, and announcement we've covered — backdated to the agency's own publication date.`}
  canonical={`https://articles.folaform.com/authority/${authority}`}
>
  <section class="hero shell">
    <a class="pill" data-authority={authority} href={`/authority/${authority}`}>
      {authority}
    </a>
    <h1>{long}</h1>
    <p class="hero__lede">
      Articles covering policy from {long}. Sorted by the agency's
      own publication date.
    </p>
  </section>

  <section class="list shell">
    <div class="grid">
      {entries.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 48px 0 24px;
  }
  .hero h1 {
    margin: 12px 0 14px;
    font-size: 2.2rem;
  }
  .hero__lede {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: 64ch;
  }
  .list {
    padding-bottom: 36px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 18px;
  }
</style>
