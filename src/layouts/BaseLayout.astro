---
/**
 * Shared HTML shell — head with SEO meta, header with logo + nav +
 * theme toggle, main slot, structured footer. Every page on
 * articles.folaform.com extends this.
 *
 * The inline boot script in <head> applies the user's persisted
 * theme choice before paint, so dark-mode users don't get a flash
 * of light content on navigation.
 */
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import logoLight from '../assets/fola-logo-light.png';
import logoDark  from '../assets/fola-logo-dark.png';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  isArticle?: boolean;
  /** Optional Schema.org JSON-LD payload. When provided, rendered
   *  as <script type="application/ld+json"> in <head>. Article
   *  pages pass an Article + Person + Organization + Breadcrumb
   *  graph here; landing pages can pass a WebSite block. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://articles.folaform.com/og-image.png',
  publishedTime,
  modifiedTime,
  isArticle = false,
  jsonLd,
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (prefix: string) =>
  prefix === '/' ? path === '/' : path.startsWith(prefix);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Apple Smart App Banner — associates the site with the Fola iOS app
        (App Store id 6784064225) and prompts iOS Safari visitors to get it. */}
    <meta name="apple-itunes-app" content="app-id=6784064225" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f4f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17181b" media="(prefers-color-scheme: dark)" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Pre-paint theme application — eliminates flash on dark mode.
         Reads localStorage; falls through to prefers-color-scheme. -->
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('fola-articles-theme');
          if (v === 'dark' || v === 'light') {
            document.documentElement.dataset.theme = v;
          }
        } catch (_) {}
      })();
    </script>

    <!-- OpenGraph -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Fola — Articles" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Fola Articles"
      href="/rss.xml"
    />

    <!-- Favicons (light + dark + Apple touch + icon-192) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-dark.ico" sizes="any"
          media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    {/* Schema.org JSON-LD — driven by the per-page layout.
        Search Console (Jun 2026) + the 2026 LLM-SEO research show
        pages with Article + Person + Organization schema land
        2-3× more AI-Overview citations than pages without. The
        block is emitted as one <script> tag so the @graph stays
        coherent across crawl passes. */}
    {jsonLd && (
      <script type="application/ld+json"
              set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="site-header__brand" href="/">
          <img class="brand-logo-light" src={logoLight.src} alt="Fola" width="120" height="32" />
          <img class="brand-logo-dark"  src={logoDark.src}  alt="Fola" width="120" height="32" />
          <span class="site-header__brand-text">
            Articles<span> · Fola</span>
          </span>
        </a>
        <nav class="site-header__nav" aria-label="Primary">
          <a href="/"
             class="site-header__nav-key"
             aria-current={isActive('/') && path === '/' ? 'page' : undefined}
          >Latest</a>
          <a href="/authority/USCIS"
             aria-current={isActive('/authority/USCIS') ? 'page' : undefined}
          >USCIS</a>
          <a href="/authority/DOS"
             aria-current={isActive('/authority/DOS') ? 'page' : undefined}
          >DOS</a>
          <a href="/authority/DHS"
             aria-current={isActive('/authority/DHS') ? 'page' : undefined}
          >DHS</a>
          <a href="/authority/DOJ-EOIR"
             aria-current={isActive('/authority/DOJ-EOIR') ? 'page' : undefined}
          >EOIR</a>
          <a href="/tags"
             aria-current={isActive('/tags') ? 'page' : undefined}
          >Topics</a>
          <a
            href="https://docs.folaform.com"
            target="_blank"
            rel="noopener"
            class="site-header__nav-key"
          >Docs ↗</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <div class="site-footer__inner">
          <div class="site-footer__brand">
            <div class="site-footer__brand-row">
              <img class="brand-logo-light" src={logoLight.src} alt="Fola" width="120" height="24" />
              <img class="brand-logo-dark"  src={logoDark.src}  alt="Fola" width="120" height="24" />
              <strong>Articles</strong>
            </div>
            <p style="margin:0;max-width:46ch;line-height:1.55;">
              Plain-English breakdowns of every USCIS memo, DOS cable,
              and DHS rule that touches U.S. immigration practice —
              backdated to the agency's own publication date.
            </p>
          </div>

          <div class="site-footer__col">
            <h4>By authority</h4>
            <ul>
              <li><a href="/authority/USCIS">USCIS</a></li>
              <li><a href="/authority/DOS">DOS</a></li>
              <li><a href="/authority/DHS">DHS</a></li>
              <li><a href="/authority/DOJ-EOIR">DOJ-EOIR</a></li>
              <li><a href="/authority/DOL">DOL</a></li>
            </ul>
          </div>

          <div class="site-footer__col">
            <h4>Browse</h4>
            <ul>
              <li><a href="/">Latest</a></li>
              <li><a href="/tags">All topics</a></li>
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>

          <div class="site-footer__col">
            <h4>Fola</h4>
            <ul>
              <li><a href="https://folaform.com" target="_blank" rel="noopener">Workspace ↗</a></li>
              <li><a href="https://docs.folaform.com" target="_blank" rel="noopener">Documentation ↗</a></li>
              <li><a href="https://folaform.com/legal/privacy">Privacy</a></li>
              <li><a href="https://folaform.com/legal/terms">Terms</a></li>
            </ul>
          </div>
        </div>

        <p class="site-footer__legal">
          © {new Date().getFullYear()} Fola — an AI-native
          immigration &amp; compliance practice. Educational content
          only. Not legal advice. We are not a law firm.
        </p>
      </div>
    </footer>
  </body>
</html>
