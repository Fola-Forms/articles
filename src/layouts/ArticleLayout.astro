---
/**
 * Single-article layout — eyebrow with authority + category, big
 * serif title, lede, byline + dates + reading time, primary-source
 * citation card, the article body via <slot/>, disclaimer, tag
 * chips, "Was this article helpful?" feedback widget.
 */
import BaseLayout from './BaseLayout.astro';
import PageFeedback from '../components/PageFeedback.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { resolveAuthor, personBlock } from '../lib/authors';

export interface Props {
  entry: CollectionEntry<'articles'>;
}

const { entry } = Astro.props;
const { data } = entry;
const slug = entry.id.replace(/\.(md|mdx)$/, '');

// ── Related articles ────────────────────────────────────────
//
// Scoring (highest wins):
//   +5 same authority
//   +4 same category
//   +2 per overlapping tag (capped at 6 — three matching tags is
//       already a strong signal, more shouldn't dominate the
//       authority/category match)
//
// Excludes self + drafts. Ties broken by publish date desc so a
// fresher article wins. Top 3 surface as the related strip.
const relatedCandidates = (await getCollection('articles'))
  .filter((e) => !e.data.draft && e.id !== entry.id);
const tagSet = new Set(data.tags);
const scored = relatedCandidates.map((c) => {
  let score = 0;
  if (c.data.authority === data.authority) score += 5;
  if (c.data.category === data.category) score += 4;
  let tagOverlap = 0;
  for (const t of c.data.tags) if (tagSet.has(t)) tagOverlap++;
  score += Math.min(tagOverlap, 3) * 2;
  return { entry: c, score };
});
const related = scored
  .filter((s) => s.score > 0)
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.entry.data.publishDate.getTime() - a.entry.data.publishDate.getTime();
  })
  .slice(0, 3)
  .map((s) => s.entry);

const canonical = new URL(`/articles/${slug}`, Astro.site).toString();

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
const publishedDisplay = fmt(data.publishDate);
const revisedDisplay = data.revisedDate ? fmt(data.revisedDate) : null;

const heroAbs = data.heroImage
  ? new URL(data.heroImage.src, Astro.site).toString()
  : undefined;

const authorityLong: Record<string, string> = {
  USCIS: 'U.S. Citizenship and Immigration Services',
  DOS: 'U.S. Department of State',
  DHS: 'U.S. Department of Homeland Security',
  'DOJ-EOIR': 'Executive Office for Immigration Review',
  DOL: 'U.S. Department of Labor',
  OTHER: 'Other authority',
};

// ── Schema.org JSON-LD graph ──────────────────────────────
//
// Author + Article + Organization + BreadcrumbList. AI Overviews
// cite pages with Article + Person 2-3× more often than equivalent
// pages with anonymous authorship per the March 2026 Core Update
// research; pages with the @graph hierarchy (everything inside one
// JSON-LD block) parse cleaner than the equivalent multiple-script
// pattern.
const author = resolveAuthor(data.author);
const articleImages = heroAbs ? [heroAbs] : [
  'https://articles.folaform.com/og-image.png',
];
const jsonLdGraph: Array<Record<string, unknown>> = [
  {
    '@type': 'Article',
    '@id': canonical + '#article',
    'headline': data.title,
    'description': data.description,
    'image': articleImages,
    'datePublished': data.publishDate.toISOString(),
    'dateModified': (data.revisedDate ?? data.publishDate).toISOString(),
    'author': {
      '@id': 'https://articles.folaform.com/#person-' + author.key,
    },
    'publisher': { '@id': 'https://folaform.com/#org' },
    'mainEntityOfPage': canonical,
    'articleSection': data.category,
    'keywords': data.tags.join(', '),
    'isBasedOn': data.sourceUrl,
    'inLanguage': 'en-US',
  },
  personBlock(author),
  {
    '@type': 'Organization',
    '@id': 'https://folaform.com/#org',
    'name': 'Fola',
    'legalName': 'Fola, Inc.',
    'url': 'https://folaform.com',
    'logo': 'https://folaform.com/icon-512.png',
    'description':
      'Fola is an AI-native immigration & compliance practice — '
      + 'AI-assisted preparation of USCIS, EOIR, DOL ETA/PERM, and '
      + 'federal court forms with live preview, three-layer '
      + 'attorney-level AI Review, and a chat agent that pulls answers '
      + 'from a saved client profile.',
    'sameAs': [
      'https://docs.folaform.com',
      'https://articles.folaform.com',
      'https://status.folaform.com',
    ],
  },
  {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1,
        'name': 'Articles',
        'item': 'https://articles.folaform.com/' },
      { '@type': 'ListItem', 'position': 2,
        'name': authorityLong[data.authority] ?? data.authority,
        'item': `https://articles.folaform.com/authority/${data.authority}` },
      { '@type': 'ListItem', 'position': 3,
        'name': data.title,
        'item': canonical },
    ],
  },
];
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@graph': jsonLdGraph,
};
---
<BaseLayout
  title={`${data.title} — Fola Articles`}
  description={data.description}
  canonical={canonical}
  ogImage={heroAbs}
  publishedTime={data.publishDate.toISOString()}
  modifiedTime={data.revisedDate?.toISOString()}
  isArticle={true}
  jsonLd={articleJsonLd}
>
  <article class="article">
    <!-- Back navigation. Defaults to /articles (works without JS
         on direct nav) and upgrades to history.back() when the
         user came from another page on this same site — the
         enhancement is the small <script> at the bottom of this
         file. -->
    <nav class="article__back shell" aria-label="Back to articles">
      <a class="article__back-link" href="/articles" data-back>
        <svg
          aria-hidden="true"
          width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        >
          <path d="M19 12H5" />
          <path d="M12 19l-7-7 7-7" />
        </svg>
        <span data-back-label>All articles</span>
      </a>
    </nav>

    <header class="article__head shell">
      <div class="article__eyebrow">
        <a
          class="pill"
          data-authority={data.authority}
          href={`/authority/${data.authority}`}
          title={authorityLong[data.authority] ?? data.authority}
        >{data.authority}</a>
        <a class="pill" href={`/tags/${data.category}`}
        >{data.category.replace(/-/g, ' ')}</a>
      </div>
      <h1 class="article__title">{data.title}</h1>
      <p class="article__lede">{data.description}</p>
      <div class="article__meta">
        <span class="article__byline">By {data.author}</span>
        <span class="article__sep">·</span>
        <time datetime={data.publishDate.toISOString()}>
          {publishedDisplay}
        </time>
        {revisedDisplay && (
          <>
            <span class="article__sep">·</span>
            <time datetime={data.revisedDate!.toISOString()}>
              Revised {revisedDisplay}
            </time>
          </>
        )}
        {data.readingMinutes && (
          <>
            <span class="article__sep">·</span>
            <span>{data.readingMinutes} min read</span>
          </>
        )}
      </div>
    </header>

    {data.heroImage && (
      <figure class="article__hero shell">
        <img
          src={data.heroImage.src}
          alt={data.heroAlt ?? data.title}
          width={data.heroImage.width}
          height={data.heroImage.height}
          loading="eager"
        />
      </figure>
    )}

    <div class="shell">
      <aside class="article__source" aria-label="Primary source">
        <span class="article__source-label">Primary source</span>
        <a class="article__source-link" href={data.sourceUrl}
           target="_blank" rel="noopener noreferrer">
          {data.sourceUrl}
        </a>
        {data.sourcePdf && (
          <a class="article__source-pdf" href={data.sourcePdf}
             target="_blank" rel="noopener">
            <span aria-hidden="true">⬇</span> Download PDF
          </a>
        )}
      </aside>

      <div class="article__body">
        <slot />
      </div>

      <aside class="article__disclaimer">
        <strong>Disclaimer.</strong> Fola is a software company,
        not a law firm. Nothing on this page is legal advice and
        reading it does not create an attorney-client relationship.
        Immigration law is high-stakes and fact-specific; consult a
        licensed immigration attorney before acting on anything you
        read here. Policy can change without notice — verify against
        the primary source linked above.
        <span class="article__disclaimer-aux">
          Some sections may be drafted with editorial assistance and
          reviewed before publication.
        </span>
      </aside>

      <nav class="article__tags" aria-label="Tags">
        {data.tags.map((t) => (
          <a class="pill" href={`/tags/${t}`}>#{t}</a>
        ))}
      </nav>

      <PageFeedback />
    </div>

    {related.length > 0 && (
      <section class="article__related shell" aria-labelledby="related-heading">
        <header class="article__related-head">
          <h2 id="related-heading" class="article__related-title">Related articles</h2>
          <a class="article__related-more" href="/articles">Browse all →</a>
        </header>
        <div class="article__related-grid">
          {related.map((rel) => (
            <ArticleCard entry={rel} variant="compact" />
          ))}
        </div>
      </section>
    )}
  </article>

  <script>
    // Progressive enhancement on the back button. When the user
    // arrived from another page on articles.folaform.com (same
    // origin), swap the link's behaviour to history.back() so the
    // browser scroll position + filter state is restored. Direct
    // landings (referrer empty or off-site) keep the static
    // /articles fallback.
    document.querySelectorAll<HTMLAnchorElement>('a[data-back]').forEach((a) => {
      try {
        const ref = document.referrer;
        if (!ref) return;
        const refOrigin = new URL(ref).origin;
        if (refOrigin !== window.location.origin) return;
        const label = a.querySelector<HTMLElement>('[data-back-label]');
        if (label) label.textContent = 'Back';
        a.addEventListener('click', (ev) => {
          ev.preventDefault();
          history.back();
        });
      } catch { /* malformed referrer — keep the static fallback */ }
    });
  </script>
</BaseLayout>

<style>
  /* Header sits in the SAME 72ch column as the body below it, so
     the title's left edge aligns with the first paragraph instead
     of flushing left to the wider 1120px shell. The .shell class
     on the same element still supplies the responsive horizontal
     padding — .article__head's max-width just narrows the band. */
  .article__head {
    max-width: var(--measure);
    margin-left: auto;
    margin-right: auto;
    padding-top: 56px;
    padding-bottom: 24px;
  }
  @media (max-width: 640px) {
    .article__head { padding-top: 32px; }
  }
  .article__eyebrow {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .article__title {
    font-family: var(--font-display);
    margin: 0 0 16px;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.12;
    letter-spacing: -0.028em;
    color: var(--ink);
    max-width: 28ch;
  }
  .article__lede {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 22px;
    max-width: 58ch;
    font-weight: 400;
  }
  .article__meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    color: var(--ink-mute);
    font-size: 14px;
  }
  .article__byline {
    color: var(--ink-soft);
    font-weight: 500;
  }
  .article__sep {
    color: var(--ink-faint);
  }

  .article__hero {
    margin: 12px auto 32px;
  }
  .article__hero img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
  }

  .article__source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    background: var(--bg-accent);
    border: 1px solid var(--accent);
    color: var(--accent-ink);
    border-radius: var(--radius-sm);
    padding: 14px 18px;
    margin: 0 auto 36px;
    font-size: 14.5px;
    max-width: var(--measure);
  }
  .article__source-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent-ink);
    flex-shrink: 0;
  }
  .article__source-link {
    flex: 1;
    color: var(--accent-ink);
    word-break: break-all;
    text-decoration-color: color-mix(in srgb, var(--accent-ink) 30%, transparent);
  }
  .article__source-pdf {
    background: var(--accent);
    color: #fff !important;
    padding: 6px 12px;
    border-radius: var(--radius-xs);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .article__source-pdf:hover {
    background: var(--accent-ink);
    color: #fff !important;
  }

  .article__body {
    max-width: var(--measure);
    margin: 0 auto;
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.72;
    color: var(--ink);
  }
  .article__body :global(h2) {
    font-family: var(--font-display);
    border-top: 1px solid var(--hairline-light);
    padding-top: 1.4em;
    margin-top: 1.8em;
    font-size: 1.7rem;
    letter-spacing: -0.02em;
  }
  .article__body :global(h2:first-child) {
    border-top: 0;
    padding-top: 0;
    margin-top: 0.4em;
  }
  .article__body :global(h3) {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin-top: 1.6em;
    letter-spacing: -0.012em;
  }
  .article__body :global(p) {
    margin: 1em 0;
  }
  .article__body :global(ul),
  .article__body :global(ol) {
    padding-left: 1.4em;
    margin: 1em 0;
  }
  .article__body :global(li) {
    margin: 0.5em 0;
  }
  .article__body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .article__body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .article__body :global(a:hover) {
    color: var(--accent-ink);
    text-decoration-color: currentColor;
  }
  .article__body :global(blockquote) {
    font-family: var(--font-serif);
    font-style: italic;
  }
  .article__body :global(hr) {
    margin: 36px 0;
    border: 0;
    border-top: 1px solid var(--hairline);
  }
  .article__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-family: var(--font-sans);
    font-size: 0.96rem;
  }
  .article__body :global(th),
  .article__body :global(td) {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid var(--hairline-light);
  }
  .article__body :global(th) {
    background: var(--bg-sunken);
    font-weight: 600;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .article__disclaimer {
    background: var(--bg-amber);
    border-left: 3px solid var(--amber);
    color: var(--amber);
    padding: 16px 20px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 14px;
    line-height: 1.6;
    max-width: var(--measure);
    margin: 48px auto 0;
  }
  .article__disclaimer strong {
    font-weight: 700;
  }
  .article__disclaimer-aux {
    display: inline;
    font-size: 11px;
    color: var(--ink-faint);
    opacity: 0.7;
    margin-left: 4px;
  }
  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 32px auto 0;
    max-width: var(--measure);
  }

  /* Back navigation — sits above the article header at the same
     measure column the title uses. Subtle but obvious chrome:
     muted text, accent on hover, a small chevron icon. The
     progressive-enhancement script swaps the label to "Back"
     when the user is returning from another page on this site. */
  .article__back {
    max-width: var(--measure);
    margin-left: auto;
    margin-right: auto;
    padding-top: 28px;
    padding-bottom: 0;
  }
  @media (max-width: 640px) {
    .article__back { padding-top: 18px; }
  }
  .article__back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px 6px 6px;
    margin-left: -6px;
    border-radius: var(--radius-xs);
    color: var(--ink-mute);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
    transition: color 120ms ease, background 120ms ease;
  }
  .article__back-link:hover {
    color: var(--accent);
    background: var(--bg-accent);
    text-decoration: none;
  }
  .article__back-link svg {
    transition: transform 140ms ease;
  }
  .article__back-link:hover svg {
    transform: translateX(-2px);
  }

  /* Related articles strip — sits below the feedback widget. Uses
     the same compact ArticleCard variant the homepage sidebar
     would, so styling stays consistent across the site. */
  .article__related {
    max-width: var(--measure);
    margin: 56px auto 0;
    padding-top: 32px;
    border-top: 1px solid var(--hairline);
  }
  .article__related-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .article__related-title {
    font-family: var(--font-display);
    margin: 0;
    font-size: 1.4rem;
    letter-spacing: -0.018em;
    color: var(--ink);
  }
  .article__related-more {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
    text-decoration: none;
    font-weight: 600;
  }
  .article__related-more:hover {
    color: var(--accent);
  }
  .article__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }
  @media (max-width: 640px) {
    .article__related { margin-top: 40px; padding-top: 24px; }
    .article__related-grid { grid-template-columns: 1fr; }
  }
</style>
